class Solution:
    def climbStairs(self, n: int) -> int:
        hash_map = {}

        def dp(n):
            if n <= 2:
                return n
            elif n in hash_map:
                return hash_map[n]
            else:
                hash_map[n] = dp(n-1) + dp(n-2)
                return hash_map[n]

        
        return dp(n)
        
